# Ollama configuration
OLLAMA_BASE_URL=http://localhost:11434
MODEL=gpt-oss:20b 

# Tool configuration
DUCKDUCKGO_SEARCH_ENABLED=True
EMAIL_ENABLED=False

# Web search / browsing
BRAVE_API_KEY=your_brave_api_key
PLAYWRIGHT_BROWSER=chromium

# Weaviate RAG (local)
WEAVIATE_URL=http://localhost:8080
WEAVIATE_INDEX=Documents

# Google Calendar (OAuth app)
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2/callback
GOOGLE_TOKEN_PATH=./google_tokens.json
GOOGLE_CALENDAR_ID=primary

# Local access
FILE_ROOT=/
SHELL_ALLOWLIST=ls,cat,rg,pwd,head,tail,python,python3,node,npm,docker,git status,git diff,find,nano,touch
SHELL_DENYLIST=rm -rf,reboot,shutdown

# IMAP configuration (only needed if EMAIL_ENABLED is True)
IMAP_SERVER=your_imap_server
IMAP_USERNAME=your_email@example.com
IMAP_PASSWORD=your_password
